# Kopieren nach .env und ausfüllen. Die Werte nie ins Repo, nie in Chat oder Tickets.
#   Hash:   docker compose run --rm -it app node scripts/secrets.js hash
#   Secret: docker compose run --rm app node scripts/secrets.js secret
APP_PASSWORD_HASH=
SESSION_SECRET=

# Zeitzone für "heute" und Uhrzeiten
TZ=Europe/Vienna

# Hinter einem Reverse Proxy (Caddy): 1. Nur für reines HTTP-Testen: COOKIE_SECURE=false
#TRUST_PROXY=1
#COOKIE_SECURE=false
